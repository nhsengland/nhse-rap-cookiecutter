# Environment variables live here. They are read automatically by `config.py`
# (via the python-dotenv package) so you can keep secrets and machine-specific
# settings out of your code.
#
# Example:
#   DATA_API_KEY=your-secret-key-here
#
# IMPORTANT: this file is listed in .gitignore and must NEVER be committed.
# Anything secret (passwords, API keys, file paths) belongs here, not in code.
